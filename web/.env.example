# Environment variables for the Trackly web app.

# Base URL of the NestJS API including the versioned prefix.
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Public base URL used to build client-access dashboard links (must match the
# API's CLIENT_PUBLIC_URL so "Copy link" matches the running app).
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# The web app's public origin, used when rendering absolute links.
NEXT_PUBLIC_PORT="3002"