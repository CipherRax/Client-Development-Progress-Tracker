# PostgreSQL connection string (Prisma format)
DATABASE_URL="postgresql://tracker:tracker_password@localhost:5432/client_tracker?schema=public"

# JWT secrets — generate strong random values for production, e.g.:
#   openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Base URL used when building client-access dashboard links, e.g.
# https://yourdomain.com/p/<token>
CLIENT_PUBLIC_URL="http://localhost:3000/p"

PORT=3000
NODE_ENV=development

# Comma-separated list of allowed origins, or "*" for development only
CORS_ORIGIN="*"

# Global rate limit window (seconds) and request count.
# Public/auth endpoints additionally have their own stricter @Throttle overrides.
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
